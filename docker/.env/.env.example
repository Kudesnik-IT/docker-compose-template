# .env.example — Шаблон файла окружения
# Скопируйте этот файл в .env и заполните значения
#
# ВНИМАНИЕ: Этот файл можно коммитить в репозиторий.
# Никогда не коммитьте .env с реальными паролями или секретами!

#################
# ИМЯ ПРОЕКТА
#
COMPOSE_PROJECT_NAME=team

#################
# СЕТЕВЫЕ НАСТРОЙКИ
#
# Внешний IP-адрес хоста (опционально, если требуется привязка к конкретному интерфейсу)
HOST=10.0.0.1

# Базовый порт для внешнего доступа к сервисам
#
PORT_SERVICE=12345

#################
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ DOCKER
#
# Включить использование BuildKit для ускоренной и безопасной сборки
DOCKER_BUILDKIT=1
