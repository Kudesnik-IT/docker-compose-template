# .env — Локальный файл окружения
# Заполните реальными значениями
# Этот файл НЕ ДОЛЖЕН коммититься в Git (добавлен в .gitignore)

#################
# ИМЯ ПРОЕКТА
#
COMPOSE_PROJECT_NAME=team

#################
# СЕТЕВЫЕ НАСТРОЙКИ
#
HOST=10.0.0.1
PORT_SERVICE=12345

#################
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ DOCKER
#
DOCKER_BUILDKIT=1
