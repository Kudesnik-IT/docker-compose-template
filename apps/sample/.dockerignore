# .dockerignore для сервиса
#
# Цель: включить ТОЛЬКО необходимое для сборки образа
# Исключить всё остальное, особенно секреты, зависимости и временные файлы

# ========================
# Системные и скрытые файлы
# ========================
.*
!.dockerignore
!Dockerfile

# ========================
# Окружение и секреты
# ========================
.env
.env.local
.env.*
*.pem
*.key
*.crt
*.der

# ========================
# Управление версиями
# ========================
.git
.gitignore
.gitmodules

# ========================
# Логи и временные файлы
# ========================
*.log
logs/
log/
tmp/
temp/
cache/

# ========================
# Зависимости
# ========================
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ========================
# IDE и редакторы
# ========================
.vscode/
.idea/
*.iml
*.iws
*~
\#*\#
.swap
.un~
Session.vim
*.sublime-project
*.sublime-workspace

# ========================
# Документация
# ========================
README.md
LICENSE
CHANGELOG.md
AUTHORS

# ========================
# ВСЁ, ЧТО НЕ ОТНОСИТСЯ К sample
# ========================
# Исключаем всё, кроме src/ и Dockerfile
*
!src/
!src/*
!Dockerfile
!.dockerignore
